# Last-touched: 2026-08-04 — pre-publication security scan: added backup/archive/cert
# patterns after finding that RUNBOOK §4 tells operators to create backup/ inside the repo.
# Never commit real secrets, per-host state, or operator data.

# Secrets and per-host configuration
.env
.env.*
!.env.example

# Materialised config (carries your domain; the mail server also rewrites config.toml)
config/nginx/mail.conf
config/nginx/mail.sso.conf
config/stalwart/config.toml

# TLS material
*.pem
*.key
*.crt
*.p12
*.pfx
certs/

# Operator data. RUNBOOK §4 produces mail-store archives, database dumps and a copy of
# .env — committing any of those would publish an entire mailbox.
backup/
backups/
*.bak
*.tar.gz
*.tgz
*.sql
*.sql.gz
*.dump

# Intermediate capture frames. scripts/capture_tour.mjs regenerates them; only the
# assembled tour.gif and the still screenshots are committed.
docs/media/frames/

# Runtime noise
__pycache__/
*.pyc
*.log
