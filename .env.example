# Last-touched: 2026-08-13 — webmail to v1.8.1 (DKIM send-path fix upstream #461), so every pin is
# now current or a declared lag. Earlier the same day: Keycloak to 26.7.1, the patch floor for six
# advisories (four High), and the postgres digest re-pinned after its floating tag moved — all three
# found by scripts/check_pins.py. Mail server stays at v0.13.4, the floor for GHSA-8jqj-qj5p-v5rr.
# Copy to .env (install.sh writes it for you, mode 600).
# NEVER commit .env — .gitignore blocks it.

# ============ BASE (Full Mail edition) ============
MAIL_DOMAIN=mail.example.com
APP_NAME=Mail

# ── Images ────────────────────────────────────────────────────────────────────
# Digests pin the exact bytes. A tag can be re-pointed by whoever can push; a digest
# cannot. Leave a *_DIGEST empty to follow the tag (not recommended).
# Verify one yourself:  docker manifest inspect <image>:<tag>
# Patch floor is 0.13.4. v0.11.8 shipped here until 2026-08-07 and is NOT safe: it predates
# the fix for GHSA-8jqj-qj5p-v5rr (High, unbounded memory allocation in the IMAP server,
# exploitable WITHOUT authentication). The image was also renamed from
# stalwartlabs/mail-server at this point. Upgrading an existing install migrates the database
# one way — see docs/RUNBOOK.md §6 and back up first.
# Upstream is at v0.16.16; this repo does not follow it yet, because 0.16.0 replaces the TOML
# config with a typed JSON schema and drops the REST management API that every first-run
# instruction here uses. That is tracked in CHANGELOG.md "Known gaps".
STALWART_VERSION=v0.13.4
STALWART_DIGEST=@sha256:5d0e3a332dfb3db8852d9fabb76c1b479b5ee11aa45607d7d48fb7e9b2d3a1bc

# Official publisher: GitHub Container Registry (github.com/bulwarkmail/webmail).
# `latest` is a moving target and is deliberately NOT used here: it is re-pointed on every
# upstream release, so two installs a week apart would not run the same webmail.
# v1.4.8 was pinned here until 2026-08-05 and is NOT safe: it predates the fixes for five
# High advisories, including CVE-2026-34834 (authentication bypass in verifyIdentity()) and
# CVE-2026-34833 (password returned by /api/auth/session). Patch floor is 1.4.11. Never pin
# below it — a digest pin makes a vulnerable build permanent instead of drifting to a fix.
BULWARK_IMAGE=ghcr.io/bulwarkmail/webmail
# 1.8.1 re-releases 1.8.0's code: a GitHub Actions incident left the 1.8.0 build queued and no
# image was ever published for that tag, so 1.8.1 is the first pullable build of that line. It
# carries a send-path correctness fix — mail now goes out through the identity's own account
# client so DKIM matches the From domain (upstream #461) — which matters on a stack that signs.
BULWARK_VERSION=v1.8.1
BULWARK_DIGEST=@sha256:97d9d96adfb7c1d221b71b90b8380b98e2e5623f64ba62b090e45911f4ee0b3b

# nginx numbers its STABLE branches with an even minor (1.28, 1.30) and its mainline with an
# odd one (1.29, 1.31). 1.27 was mainline and reached end of life — a mail front door should
# sit on the current stable branch, not on a retired mainline.
NGINX_VERSION=1.30.4-alpine
NGINX_DIGEST=@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

# ── TLS ───────────────────────────────────────────────────────────────────────
# Point at the REAL files, not the Let's Encrypt `live/` symlinks: a bind-mounted
# symlink dangles inside the container because its target is not mounted.
# install.sh resolves them with `readlink -f` for you.
TLS_FULLCHAIN=/etc/letsencrypt/archive/mail.example.com/fullchain1.pem
TLS_PRIVKEY=/etc/letsencrypt/archive/mail.example.com/privkey1.pem

# ── Secrets (install.sh generates real random values) ─────────────────────────
WEBMAIL_SESSION_SECRET=
# Bootstrap admin for the mail server. Use it once to create your domain and
# accounts, then rotate it.
STALWART_FALLBACK_ADMIN_SECRET=

# ============ SSO edition ONLY (docker-compose.sso.yml) ============
# Leave unset for the Full Mail edition. The overlay ships its own PostgreSQL
# service (`db`) — you do not need to provide a database.
IDP_DOMAIN=id.example.com
# 26.0 reached end of life; 26.7 is the current maintained line. Both take the full-URL
# form of KC_HOSTNAME (25+), so the setting below does not change with this bump.
# 26.7.1 is the patch floor for six advisories published 2026-08-06 — four High, including
# GHSA-95cx-vmr5-3cmr (DCR policy allows role forgery via user property mappers),
# GHSA-95rm-h7g9-rhcf (DCR protocol mapper type-swap privilege escalation),
# GHSA-fgq2-hxm5-8xg2 (SAML idp-initiated broker login bypasses link-only restriction) and
# GHSA-f8m4-v488-rmrm (SAML broker metadata import disables response signature validation).
# 26.7.0 shipped here for one week and was below that floor. Never pin below 26.7.1.
KEYCLOAK_VERSION=26.7.1
KEYCLOAK_DIGEST=@sha256:f1f1f01e472c8a78df40d8f2a49a925274eda4d3d80d5f6edbb5c880ee3c01c6
# Keycloak 25+ : full URL, e.g. https://id.example.com
# Keycloak 24- : BARE hostname, e.g. id.example.com — a full URL produces a doubled
#                scheme in the issuer (`https://https//id.example.com/realms/...`).
KC_HOSTNAME_VALUE=https://id.example.com
OAUTH_CLIENT_ID=webmail
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER_URL=https://id.example.com/realms/mail
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak's database. The host is the compose service name `db`; only the
# database name, user and password are configurable here.
# `17-alpine` tracks the 17 line and is re-pointed upstream on every 17.x patch, so the digest
# below is the only thing holding this install still. Re-pinned 2026-08-13 after
# scripts/check_pins.py found the tag had moved off the digest pinned here.
POSTGRES_VERSION=17-alpine
POSTGRES_DIGEST=@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
