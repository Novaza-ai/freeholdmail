# Last-touched: 2026-08-04 — GATE-1/2 QA: replaced CHANGEME placeholders with verified
# coordinates and added digest pins. Copy to .env (install.sh writes it for you, mode 600).
# NEVER commit .env — .gitignore blocks it.

# ============ BASE (Full Mail edition) ============
MAIL_DOMAIN=mail.example.com
APP_NAME=Mail

# ── Images ────────────────────────────────────────────────────────────────────
# Digests pin the exact bytes. A tag can be re-pointed by whoever can push; a digest
# cannot. Leave a *_DIGEST empty to follow the tag (not recommended).
# Verify one yourself:  docker manifest inspect <image>:<tag>
STALWART_VERSION=v0.11.8
STALWART_DIGEST=@sha256:a5ce0615640b29a01c0a55b9fff6dd2c9dfa261ec87862c22e4db7e0254cdb1f

# Official publisher: GitHub Container Registry (github.com/bulwarkmail/webmail).
# `latest` is a moving target and is deliberately NOT used here: it is re-pointed on every
# upstream release, so two installs a week apart would not run the same webmail.
# v1.4.8 was pinned here until 2026-08-05 and is NOT safe: it predates the fixes for five
# High advisories, including CVE-2026-34834 (authentication bypass in verifyIdentity()) and
# CVE-2026-34833 (password returned by /api/auth/session). Patch floor is 1.4.11. Never pin
# below it — a digest pin makes a vulnerable build permanent instead of drifting to a fix.
BULWARK_IMAGE=ghcr.io/bulwarkmail/webmail
BULWARK_VERSION=v1.7.8
BULWARK_DIGEST=@sha256:1ea45e292e7baf84eccdfe3d7ed96fe4487f2b95025a6ab569706915f6798979

NGINX_VERSION=1.27-alpine
NGINX_DIGEST=@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# ── TLS ───────────────────────────────────────────────────────────────────────
# Point at the REAL files, not the Let's Encrypt `live/` symlinks: a bind-mounted
# symlink dangles inside the container because its target is not mounted.
# install.sh resolves them with `readlink -f` for you.
TLS_FULLCHAIN=/etc/letsencrypt/archive/mail.example.com/fullchain1.pem
TLS_PRIVKEY=/etc/letsencrypt/archive/mail.example.com/privkey1.pem

# ── Secrets (install.sh generates real random values) ─────────────────────────
WEBMAIL_SESSION_SECRET=
# Bootstrap admin for the mail server. Use it once to create your domain and
# accounts, then rotate it.
STALWART_FALLBACK_ADMIN_SECRET=

# ============ SSO edition ONLY (docker-compose.sso.yml) ============
# Leave unset for the Full Mail edition. The overlay ships its own PostgreSQL
# service (`db`) — you do not need to provide a database.
IDP_DOMAIN=id.example.com
KEYCLOAK_VERSION=26.0
KEYCLOAK_DIGEST=@sha256:09a381c715ab0b111835b70f2905955274843a219c6f27efb348e4d9f4086858
# Keycloak 25+ : full URL, e.g. https://id.example.com
# Keycloak 24- : BARE hostname, e.g. id.example.com — a full URL produces a doubled
#                scheme in the issuer (`https://https//id.example.com/realms/...`).
KC_HOSTNAME_VALUE=https://id.example.com
OAUTH_CLIENT_ID=webmail
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER_URL=https://id.example.com/realms/mail
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak's database. The host is the compose service name `db`; only the
# database name, user and password are configurable here.
POSTGRES_VERSION=17-alpine
POSTGRES_DIGEST=@sha256:778d0b486d6daa02b77434d0358ec57a1b21fd8b6d22ac2eef56a33e816928f6
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
