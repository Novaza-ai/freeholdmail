# Last-touched: 2026-08-04 — SSO edition nginx (Mail + SSO): FE + BE + Keycloak discovery
# Copy to mail.sso.conf (install.sh does this when you pick the SSO edition).

server {
    listen 443 ssl;
    http2 on;
    server_name MAIL_DOMAIN_PLACEHOLDER;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    location / {
        proxy_pass http://webmail:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # JMAP only. `/api` deliberately NOT routed here: the webmail owns 17 of its own
    # /api/* routes (config, auth, settings…), and the mail server's admin API must
    # never be reachable from the public internet — see SECURITY.md.
    location ~ ^/(jmap|\.well-known/jmap) {
        proxy_pass http://mailserver:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # SSO edition only: IdP discovery (Keycloak)
    location /.well-known/openid-configuration {
        proxy_pass http://idp:8080/realms/mail/.well-known/openid-configuration;
        proxy_set_header Host $host;
    }
}

server {
    listen 80;
    server_name MAIL_DOMAIN_PLACEHOLDER;
    location / { return 301 https://$host$request_uri; }
}
